# Copy this file to .env.local (or .env) and fill in the values.
# Never commit real credentials.

# Public URL of the deployed site (no trailing slash). Used for canonical URLs,
# Open Graph metadata, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.rkstechnologygroup.com

# Address that receives contact form submissions.
ADMIN_EMAIL=admin@example.org

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender shown on notification emails. Must use a domain verified in Resend.
# For local testing you can use Resend's sandbox sender: onboarding@resend.dev
# (the sandbox only delivers to the email address of your Resend account).
CONTACT_FROM_EMAIL="Website Contact Form <no-reply@example.org>"

# Optional, for multi-instance/self-hosted deployments: a stable key so Server
# Action references stay valid across instances. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
